#version 460
// (OcaDim, Ray-Tracing TEST) Le premier rayon : une acceleration structure (TLAS) avec un triangle, et un rayon fixe
// parti de l'origine vers +Z. Rouge : le rayon touche le triangle ; vert : il le manque. Sert a valider la chaine
// BLAS -> TLAS -> ray_query avant de capturer un vrai maillage du jeu.
#extension GL_EXT_ray_query : require
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform accelerationStructureEXT tlas;
layout(binding = 1, rgba16f) uniform writeonly image2D out_img;

void main() {
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(out_img);
    if (px.x >= size.x || px.y >= size.y) return;
    rayQueryEXT q;
    rayQueryInitializeEXT(q, tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0xFF,
                          vec3(0.0, 0.0, 0.0), 0.001, vec3(0.0, 0.0, 1.0), 10.0);
    while (rayQueryProceedEXT(q)) {}
    const bool hit = rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionNoneEXT;
    imageStore(out_img, px, hit ? vec4(1.0, 0.0, 0.0, 1.0) : vec4(0.0, 1.0, 0.0, 1.0));
}
