#version 450
// (OcaDim 0.0.6) « Rue mouillee » : la brillance des sols, sans normale et sans masque par surface.
//
// Pourquoi ce choix : une normale reconstruite depuis la profondeur (le jeu n'a pas de G-buffer) est trop bruitee, et le
// masque « surface horizontale » finissait par prendre les facades et le ciel (test abuse : tout scintillait). Ici l'effet
// s'appuie sur ce qui est stable : la RUE EST EN BAS DE L'IMAGE, et une surface mouillee s'assombrit, prend une lueur de
// ciel rasante, et scintille un peu. Aucune information hors champ, aucune normale : ca ne peut ni baver ni se casser.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D color_tex;
layout(binding = 1) uniform sampler2D depth_tex;
layout(binding = 2, r11f_g11f_b10f) uniform writeonly image2D out_img;   // (OcaDim 0.0.6 : le format de la cible, pour une copie sans conversion)

layout(push_constant) uniform P {
    vec4 proj;
    vec2 jitter;
    vec2 inv_size;
    float near_z;
    float max_dist;
    float thickness;
    float strength;  // (0 = aucun effet, 1 = plein)
    int steps;
    int pad0;
    int pad1;        // (le temps, en millisecondes : l'animation des scintillements)
    int pad2;
    vec3 view_up;
    float pad3;
} pc;

float scene_z(float d) { return -pc.proj.w / (d * 2.0 - 1.0 + pc.proj.z); }

float hash21(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

void main() {
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(out_img);
    if (px.x >= size.x || px.y >= size.y) return;
    const vec2 uv = (vec2(px) + 0.5) * pc.inv_size;
    const vec4 base = textureLod(color_tex, uv, 0.0);
    if (pc.pad0 == 4) {   // (debug : le calcul tourne-t-il ? tout en vert)
        imageStore(out_img, px, vec4(0.0, 1.0, 0.0, 1.0));
        return;
    }
    const float d = textureLod(depth_tex, uv, 0.0).r;
    if (d >= 0.99995) {   // (le ciel : rien a faire)
        imageStore(out_img, px, base);
        return;
    }
    if (pc.pad0 == 5) {   // (debug : la profondeur, en gris)
        const float z = scene_z(d);
        const float g = clamp(-z / max(pc.max_dist, 1.0), 0.0, 1.0);
        imageStore(out_img, px, vec4(g, g, g, 1.0));
        return;
    }

    // (le ciel, ecrete : le tampon du jeu porte des valeurs bien au-dessus de 1)
    const vec3 sky = min(textureLod(color_tex, vec2(0.5, 0.02), 0.0).rgb, vec3(1.5));
    const vec3 sky_grey = mix(vec3(dot(sky, vec3(0.2126, 0.7152, 0.0722))), sky, 0.55);

    // (la rue : le bas de l'image. Le plus « mouille » est la ou la rue s'eloigne (vers l'horizon, au milieu), et le
    // tout premier plan reste plus mat - c'est ce que fait une vraie chaussee humide)
    const float y = uv.y;
    const float road = smoothstep(0.38, 0.66, y) * mix(1.0, 0.55, smoothstep(0.82, 1.0, y));
    // (la lueur rasante : une bande un peu au-dessus du bas, la ou l'angle est le plus rasant)
    const float band = smoothstep(0.42, 0.62, y) * (1.0 - smoothstep(0.62, 0.86, y));
    const float s = pc.strength * road;

    // (1) la pierre humide s'assombrit)
    vec3 col = base.rgb * (1.0 - 0.22 * s);
    // (2) la lueur de ciel, rasante, qui donne le « mouille »)
    col = mix(col, sky_grey, clamp(0.16 * s * (0.35 + 0.65 * band), 0.0, 0.6));
    // (3) les scintillements, uniquement sur la rue, petits et rares)
    const float dist = -scene_z(d);
    const float far_fade = 1.0 - smoothstep(pc.max_dist * 0.30, pc.max_dist * 0.85, dist);
    const float cell = clamp(1.5 + dist * 0.012, 1.5, 3.5);
    const vec2 gp = uv * vec2(float(size.x), float(size.y)) / cell;
    const float t = float(pc.pad1) * 0.001;
    float spark = 0.0;
    for (int k = 0; k < 3; k++) {
        const float ph = hash21(floor(gp) + float(k) * 17.0);
        const float life = fract(t * (0.35 + 0.55 * ph) + ph);
        const float on = smoothstep(0.84, 0.89, life) * (1.0 - smoothstep(0.93, 0.99, life));
        const float spot = step(0.960, hash21(floor(gp) + 3.7 + float(k) * 5.1));   // (4 % des cellules)
        spark += on * spot;
    }
    col += sky_grey * clamp(spark, 0.0, 1.0) * pc.strength * road * far_fade * 0.35;

    imageStore(out_img, px, vec4(col, base.a));
}
