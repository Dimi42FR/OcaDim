#version 450
// (OcaDim 0.0.6) SSR des sols, version propre.
//
// Ce qui a echoue avant : estimer une normale depuis la profondeur (bruitee) -> des taches. Ici, pas de normale : un sol
// est HORIZONTAL, et la verticale du monde (vue), on l'a (pc.view_up). Le rayon reflechi se calcule donc directement.
//
// Pour chaque pixel de sol : on reconstruit sa position en espace vue, on reflechit la direction de vue autour de la
// verticale, on marche ce rayon dans la profondeur de la scene (en espace ecran), et a l'intersection on prend la couleur
// de la scene. Un rayon qui sort de l'ecran ne donne rien (pas de repli, pas de trait).
//
// Aucune animation, aucun etat : la meme entree donne la meme sortie. Ca ne peut pas clignoter.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D color_tex;
layout(binding = 1) uniform sampler2D depth_tex;
layout(binding = 2, rgba16f) uniform writeonly image2D out_img;

layout(push_constant) uniform P {
    vec4 proj;       // (p00, p11, p22, p23)
    vec2 jitter;     // (p02, p12)
    vec2 inv_size;
    float near_z;
    float max_dist;
    float thickness;
    float strength;  // (0 = rien, 1 = plein)
    int steps;
    int pad0;
    int pad1;
    int pad2;
    vec3 view_up;    // (la verticale du monde en espace vue)
    float pad3;
} pc;

float scene_z(float d) { return -pc.proj.w / (d * 2.0 - 1.0 + pc.proj.z); }

vec3 view_pos(vec2 uv, float d) {
    const float z = scene_z(d);
    const float nx = uv.x * 2.0 - 1.0;
    const float ny = 1.0 - uv.y * 2.0;
    return vec3(-(nx + pc.jitter.x) * z / pc.proj.x, -(ny + pc.jitter.y) * z / pc.proj.y, z);
}

vec2 project(vec3 p) {
    const float w = -p.z;
    const float cx = pc.proj.x * p.x + pc.jitter.x * p.z;
    const float cy = pc.proj.y * p.y + pc.jitter.y * p.z;
    return vec2(0.5 + 0.5 * cx / w, 0.5 - 0.5 * cy / w);
}

bool inside(vec2 uv) { return uv.x >= 0.0 && uv.y >= 0.0 && uv.x <= 1.0 && uv.y <= 1.0; }

void main() {
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(out_img);
    if (px.x >= size.x || px.y >= size.y) return;
    const vec2 uv = (vec2(px) + 0.5) * pc.inv_size;
    const vec4 base = textureLod(color_tex, uv, 0.0);
    if (pc.pad0 == 4) {   // (debug : tout en vert)
        imageStore(out_img, px, vec4(0.0, 1.0, 0.0, 1.0));
        return;
    }
    const float d = textureLod(depth_tex, uv, 0.0).r;
    if (d >= 0.99995) {   // (le ciel)
        imageStore(out_img, px, base);
        return;
    }
    const vec3 p = view_pos(uv, d);
    if (p.z >= -pc.near_z * 0.5) {
        imageStore(out_img, px, base);
        return;
    }
    // (est-ce un SOL ? la profondeur y varie lentement et regulierement. On mesure la pente sur deux pixels : une
    // silhouette, une marche ou un mur la font exploser)
    const vec2 tx = pc.inv_size;
    const float dl = textureLod(depth_tex, uv - vec2(tx.x * 2.0, 0.0), 0.0).r;
    const float dr = textureLod(depth_tex, uv + vec2(tx.x * 2.0, 0.0), 0.0).r;
    const float du = textureLod(depth_tex, uv - vec2(0.0, tx.y * 2.0), 0.0).r;
    const float dd = textureLod(depth_tex, uv + vec2(0.0, tx.y * 2.0), 0.0).r;
    if (dl >= 0.99995 || dr >= 0.99995 || du >= 0.99995 || dd >= 0.99995) {
        imageStore(out_img, px, base);
        return;
    }
    const float slope = length(vec2(scene_z(dr) - scene_z(dl), scene_z(dd) - scene_z(du))) * 0.5 /
                        max(1.0, -p.z) / 4.0;
    const float flatness = 1.0 - smoothstep(0.015, 0.075, slope);
    if (flatness < 0.01) {
        imageStore(out_img, px, base);
        return;
    }
    // (le rayon reflechi : la surface est horizontale, donc la normale est la verticale du monde)
    const vec3 v = normalize(p);
    const float ndv = clamp(dot(-v, pc.view_up), 0.0, 1.0);   // (1 = vu de face, 0 = rasant)
    const vec3 r = reflect(v, pc.view_up);
    // (Fresnel : un sol renvoie peu de face, beaucoup en regardant au loin - comme une chaussee mouillee)
    const float fresnel = 0.06 + 0.94 * pow(1.0 - ndv, 4.0);
    const float weight = flatness * fresnel;
    if (weight < 0.01) {
        imageStore(out_img, px, base);
        return;
    }
    // (la marche : des pas qui s'allongent avec la distance, projetes a l'ecran)
    const int steps = clamp(pc.steps, 8, 64);
    float prev_t = 0.0;
    float hit_t = -1.0;
    vec2 hit_uv = uv;
    for (int i = 1; i <= steps; i++) {
        const float f = float(i) / float(steps);
        const float t = pc.max_dist * f * f;
        const vec3 cur = p + r * t;
        if (cur.z >= -pc.near_z * 0.5) break;
        const vec2 suv = project(cur);
        if (!inside(suv)) break;
        const float sd = textureLod(depth_tex, suv, 0.0).r;
        if (sd < 0.99995 && scene_z(sd) > cur.z) {
            float a = prev_t, b = t;
            for (int j = 0; j < 5; j++) {
                const float m = 0.5 * (a + b);
                const vec3 pm = p + r * m;
                const vec2 muv = project(pm);
                if (!inside(muv)) break;
                const float md = textureLod(depth_tex, muv, 0.0).r;
                if (md >= 0.99995 || scene_z(md) > pm.z) b = m;
                else a = m;
            }
            hit_t = b;
            hit_uv = project(p + r * b);
            break;
        }
        prev_t = t;
    }
    if (hit_t < 0.0 || !inside(hit_uv)) {   // (sorti de l'ecran : aucun reflet, jamais de repli)
        imageStore(out_img, px, base);
        return;
    }
    const float hd = textureLod(depth_tex, hit_uv, 0.0).r;
    if (hd >= 0.99995) {
        imageStore(out_img, px, base);
        return;
    }
    const vec3 hit = p + r * hit_t;
    const float gap = scene_z(hd) - hit.z;
    if (gap < 0.0 || gap > pc.thickness) {   // (le rayon a traverse un mur)
        imageStore(out_img, px, base);
        return;
    }
    // (OcaDim 0.0.6) le reflet doit etre STABLE : l'image du FSR 4 bouge d'un demi-pixel d'une image a l'autre et le
    // point d'intersection oscillait. 1) on le quantifie sur une grille de deux pixels (il ne peut plus osciller) ;
    // 2) neuf prises autour, moyennees : une rue mouillee a un reflet flou, pas un miroir
    const vec2 sz = vec2(1.0 / pc.inv_size.x, 1.0 / pc.inv_size.y);
    hit_uv = floor(hit_uv * sz / 2.0) * 2.0 / sz;
    const vec2 o1 = pc.inv_size * 1.5;
    vec3 refl = vec3(0.0);
    for (int yy = -1; yy <= 1; yy++)
        for (int xx = -1; xx <= 1; xx++)
            refl += textureLod(color_tex, hit_uv + vec2(float(xx) * o1.x, float(yy) * o1.y), 0.0).rgb;
    refl /= 9.0;
    // (le bord de la source s'efface sur quelques pixels : le reflet ne s'arrete pas net sur les bords de l'ecran)
    const float edge = min(min(uv.x, 1.0 - uv.x), min(uv.y, 1.0 - uv.y));
    const float fade = smoothstep(0.0, 0.02, edge) * (1.0 - smoothstep(0.85, 1.0, hit_t / max(pc.max_dist, 1.0)));
    const float k = clamp(pc.strength * weight * fade * 1.6, 0.0, 1.0);
    imageStore(out_img, px, vec4(mix(base.rgb, refl, k), base.a));
}
